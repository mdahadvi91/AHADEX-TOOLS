{
  "version": 1,
  "include": [
    "/",
    "/about",
    "/about/*",
    "/contact",
    "/contact/*",
    "/privacy",
    "/privacy/*",
    "/terms",
    "/terms/*",
    "/disclaimer",
    "/disclaimer/*",
    "/accessibility",
    "/accessibility/*",
    "/cookie-policy",
    "/cookie-policy/*",
    "/editorial-policy",
    "/editorial-policy/*",
    "/affiliate-disclosure",
    "/affiliate-disclosure/*",
    "/sitemap",
    "/sitemap/*",
    "/404",
    "/tools",
    "/tools/*",
    "/blog",
    "/blog/*"
  ],
  "exclude": [
    "/_headers",
    "/_redirects",
    "/_routes.json",
    "/ads.txt",
    "/robots.txt",
    "/sitemap.xml",
    "/rss.xml",
    "/humans.txt",
    "/site.webmanifest",
    "/favicon.ico",
    "/favicon-*.png",
    "/apple-touch-icon.png",
    "/android-chrome-*.png",
    "/ahadex-indexnow-key.txt",
    "/images/*",
    "/audio/*",
    "/assets/*",
    "/.well-known/*"
  ]
}
