# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GA_MEASUREMENT_ID: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Optional. If not provided or empty, GA4 tracking remains safely disabled.
VITE_GA_MEASUREMENT_ID=

# Advertising & Monetization Architecture (Phase 10)
# VITE_ENABLE_ADS: Master switch for advertisements ('true' or 'false').
VITE_ENABLE_ADS=false

# VITE_ADSENSE_CLIENT_ID: Google AdSense Publisher Client ID (format: ca-pub-XXXXXXXXXXXXXXXX)
# When provided, activates AdSense in supported ad slots.
VITE_ADSENSE_CLIENT_ID=

# VITE_AD_PROVIDER: Target ad network provider ('adsense', 'monetag', 'adsterra', 'custom')
VITE_AD_PROVIDER=adsense

# VITE_AD_DEBUG: Set to 'true' to display developer wireframe placeholders for slot inspection
VITE_AD_DEBUG=false

# VITE_AD_CONSENT_REQUIRED: Enforces explicit user consent before loading external ad scripts ('true' or 'false')
VITE_AD_CONSENT_REQUIRED=false
